#!/usr/bin/env bash
# (Re)start cp-core (gunicorn, systemd service cp-core) and wait for /api/health.
#   cp-core-run                 restart
#   systemctl status cp-core    state
#   journalctl -u cp-core -f    requests and errors
# Fallback with Django runserver: sudo systemctl stop cp-core; cp-core-runserver
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
systemctl restart cp-core
for i in $(seq 1 20); do
  sleep 1
  if out=$(curl -fsS http://127.0.0.1:8000/api/health 2>/dev/null); then echo "cp-core is up: $out"; exit 0; fi
done
echo "cp-core did not answer within 20 s; look with:  journalctl -u cp-core -n 50" >&2
exit 1
