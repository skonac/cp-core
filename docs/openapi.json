  "components": {
    "schemas": {
      "OtpRequestIn": {
        "properties": {
          "phoneNumber": {
            "title": "Phonenumber",
            "type": "string"
          },
          "eventCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eventcode"
          },
          "role": {
            "default": "participant",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "phoneNumber"
        ],
        "title": "OtpRequestIn",
        "type": "object"
      },
      "OtpVerifyIn": {
        "properties": {
          "challengeId": {
            "title": "Challengeid",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "code"
        ],
        "title": "OtpVerifyIn",
        "type": "object"
      },
      "MeUpdateIn": {
        "properties": {
          "fullName": {
            "title": "Fullname",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "required": [
          "fullName"
        ],
        "title": "MeUpdateIn",
        "type": "object"
      },
      "ConsentIn": {
        "properties": {
          "granted": {
            "title": "Granted",
            "type": "boolean"
          }
        },
        "required": [
          "granted"
        ],
        "title": "ConsentIn",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  },
