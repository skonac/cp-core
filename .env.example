# Copy to .env (dev, next to manage.py) or /etc/cp-core/env (production, CP_ENV_FILE points there).
# Real environment variables win over this file.

CP_SECRET_KEY=change-me   # python3 -c "import secrets; print(secrets.token_urlsafe(50))"
CP_DEBUG=1
CP_ALLOWED_HOSTS=cleverphotos.org,www.cleverphotos.org,localhost,127.0.0.1   # keep localhost/127.0.0.1: the face worker and cp-core-run call 127.0.0.1:8000

# Empty host = local unix socket; with user = your Linux user, Postgres "peer" auth needs no password.
CP_DB_NAME=cpcore
CP_DB_USER=ogesli
CP_DB_HOST=
CP_DB_PORT=5432
CP_DB_PASSWORD=

CP_MEDIA_ROOT=/photodisk          # the photo volume (LVM mount); events/, selfies/ live directly in it
CP_X_ACCEL=0        # 1 behind nginx: files are sent by nginx, not Django
CP_WORKER_TOKEN=devtoken

CP_SMS_DELIVERY=log    # log: no SMS leaves the server (OTP codes in the log and the admin) | live: real providers

CP_MASTER_PASS=        # non-production only, e.g. 12345: accepted as any OTP code and any account's password; empty = off

CP_ZIP_MAX_FILES=50             # photos per ZIP download request

CP_PAYMENT_PROVIDER=simulated   # simulated (every purchase succeeds, no money) | iyzico-sandbox (test cards) | iyzico-production
CP_IYZICOSANDBOX_API_KEY=       # iyzico sandbox panel: API Anahtarı
CP_IYZICOSANDBOX_SECRET_KEY=    # iyzico sandbox panel: Güvenlik Anahtarı
CP_IYZICOSANDBOX_BASE_URL=sandbox-api.iyzipay.com
#CP_IYZICOPRODUCTION_API_KEY=   # later, live keys (base URL defaults to api.iyzipay.com)
#CP_IYZICOPRODUCTION_SECRET_KEY=

CP_KVKK_VERSION=001    # current KVKK document pair: kvkk/kvkk_tr_001.pdf + kvkk_en_001.pdf
