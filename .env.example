# Copy to .env (dev, next to manage.py) or /etc/cp-core/env (production, CP_ENV_FILE points there).
# Real environment variables win over this file.

CP_SECRET_KEY=change-me   # python3 -c "import secrets; print(secrets.token_urlsafe(50))"
CP_DEBUG=1
CP_ALLOWED_HOSTS=cleverphotos.org,www.cleverphotos.org,localhost,127.0.0.1   # keep localhost/127.0.0.1: the face worker and cp-core-run call 127.0.0.1:8000

# Empty host = local unix socket; with user = your Linux user, Postgres "peer" auth needs no password.
CP_DB_NAME=cpcore
CP_DB_USER=ogesli
CP_DB_HOST=
CP_DB_PORT=5432
CP_DB_PASSWORD=

CP_MEDIA_ROOT=/photodisk          # the photo volume (LVM mount); events/, selfies/ live directly in it
CP_X_ACCEL=0        # 1 behind nginx: files are sent by nginx, not Django
CP_WORKER_TOKEN=devtoken

CP_SMS_DELIVERY=log    # log: no SMS leaves the server (OTP codes in the log and the admin) | live: real providers
CP_ILETIMERKEZI_API_KEY=     # iletimerkezi.com panel: Ayarlar -> API (+90 numbers)
CP_ILETIMERKEZI_API_HASH=
CP_ILETIMERKEZI_SENDER=      # approved sender name (başlık), exactly as in the panel, max 11 characters

CP_EMAIL_DELIVERY=log  # log: no email leaves the server (text in the log) | live: Zoho CPaaS, Zoho Mail as fallback
CP_EMAIL_REPLY_TO=             # e.g. contact@cleverphotos.org
CP_CPAAS_API_KEY=              # cpaas.zoho.eu: Mail Agent -> API -> Send Mail token, without "Zoho-enczapikey "
CP_CPAAS_FROM=                 # e.g. Clever Photos <noreply@cleverphotos.org> (any address on the verified domain)
# Zoho Mail fallback (optional; leave empty to send through CPaaS only)
CP_ZOHOMAIL_CLIENT_ID=         # api-console.zoho.eu, client "cleverphotoscore" (design/notifications.md)
CP_ZOHOMAIL_CLIENT_SECRET=
CP_ZOHOMAIL_REFRESH_TOKEN=     # from the one-time OAuth consent; never expires unless revoked
CP_ZOHOMAIL_ACCOUNT_ID=        # GET https://mail.zoho.eu/api/accounts, or: cp-core-manage email_test --accounts
CP_ZOHOMAIL_FROM=              # e.g. Clever Photos <contact@cleverphotos.org> (the mailbox or one of its aliases)

CP_MASTER_PASS=        # non-production only, e.g. 12345: accepted as any OTP code and any account's password; empty = off

CP_ZIP_MAX_FILES=50             # photos per ZIP download request

CP_PAYMENT_PROVIDER=simulated   # simulated (every purchase succeeds, no money) | iyzico-sandbox (test cards) | iyzico-production
CP_IYZICOSANDBOX_API_KEY=       # iyzico sandbox panel: API Anahtarı
CP_IYZICOSANDBOX_SECRET_KEY=    # iyzico sandbox panel: Güvenlik Anahtarı
CP_IYZICOSANDBOX_BASE_URL=sandbox-api.iyzipay.com
#CP_IYZICOPRODUCTION_API_KEY=   # later, live keys (base URL defaults to api.iyzipay.com)
#CP_IYZICOPRODUCTION_SECRET_KEY=

CP_KVKK_VERSION=002    # current KVKK document pair: legal/kvkk_tr_002.html + kvkk_en_002.html
CP_SALES_DOCS_VERSION=002   # current ÖBF + MSS templates in legal/ (002: discount lines)

# Discount on every product for everyone (signed out too); whole percent 0-100, 0 or unset = off. Restart to change.
# TITLE: label next to a discounted price; BANNER: the site-wide line. _EN is used for both languages unless _TR is set.
#CP_DISCOUNT_VALUE=15
#CP_DISCOUNT_TITLE_EN="LANSMANA ÖZEL"
#CP_DISCOUNT_BANNER_EN="HERKESE LANSMANA ÖZEL %15 İNDİRİM!"
#CP_DISCOUNT_TITLE_TR=
#CP_DISCOUNT_BANNER_TR=
