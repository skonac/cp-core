# Copy to .env (dev, next to manage.py) or /etc/cp-core/env (production, CP_ENV_FILE points there).
# Real environment variables win over this file.

CP_SECRET_KEY=change-me   # python3 -c "import secrets; print(secrets.token_urlsafe(50))"
CP_DEBUG=1
CP_ALLOWED_HOSTS=cp.futuruniq.com,cp.gesli.net,localhost,127.0.0.1

# Empty host = local unix socket; with user = your Linux user, Postgres "peer" auth needs no password.
CP_DB_NAME=cpcore
CP_DB_USER=ogesli
CP_DB_HOST=
CP_DB_PORT=5432
CP_DB_PASSWORD=

CP_MEDIA_ROOT=/var/lib/cleverphotos/media
CP_X_ACCEL=0        # 1 behind nginx: files are sent by nginx, not Django
CP_WORKER_TOKEN=devtoken
